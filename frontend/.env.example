# API Gateway URL
VITE_API_BASE_URL=http://localhost:3000/api

# Auth Service
VITE_AUTH_SERVICE_URL=http://localhost:3001/api/auth

# Patient Service
VITE_PATIENT_SERVICE_URL=http://localhost:3001/api/patients

# Doctor Service
VITE_DOCTOR_SERVICE_URL=http://localhost:3001/api/doctors

# Appointment Service
VITE_APPOINTMENT_SERVICE_URL=http://localhost:3001/api/appointments

# Payment Service
VITE_PAYMENT_SERVICE_URL=http://localhost:3001/api/payments

# Notification Service
VITE_NOTIFICATION_SERVICE_URL=http://localhost:3001/api/notifications

# AI Symptom Service
VITE_AI_SYMPTOM_SERVICE_URL=http://localhost:3001/api/ai-symptoms

# Telemedicine Service
VITE_TELEMEDICINE_SERVICE_URL=http://localhost:3001/api/telemedicine

# Cloudinary Configuration for PDF and Image Uploads
# Get your credentials from: https://cloudinary.com/console/dashboard
# Create an unsigned upload preset for client-side uploads
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key
VITE_CLOUDINARY_API_SECRET=your_api_secret
VITE_CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# App Settings
VITE_APP_NAME=MediConnect
VITE_APP_TITLE=Healthcare at your fingertips

